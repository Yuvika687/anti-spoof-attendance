# Python
__pycache__/
*.pyc
venv/
.venv/

# Raw dataset downloads (tens of GB; never commit)
raw_downloads/

# Datasets (too large for version control; regenerate via prepare_*.py)
data/celeba_spoof/*
data/casia_fasd/*
!data/celeba_spoof/.gitkeep
!data/casia_fasd/.gitkeep
data/samples/masked/*
!data/samples/masked/.gitkeep

# Trained weights / downloaded models (regenerate via train.py, auto-downloaded by face_utils.py)
# **/*.pth (not just models/*.pth) so this also covers the per-backbone
# comparison checkpoints under models/<backbone>/ added by train.py's
# auto-namespacing (models/*.pth alone doesn't match nested paths).
models/**/*.pth
models/*.onnx
models/*.tflite

# Generated outputs
outputs/plots/*
outputs/predictions/*
!outputs/plots/.gitkeep
!outputs/predictions/.gitkeep
logs/*.csv

# Breakdown/analysis results (regenerate via evaluate_breakdown.py etc.)
# Mirrors the outputs/ pattern above -- NOT "results/*" with a nested
# negation, which doesn't work: gitignore can't re-include a file inside
# a directory entry that's already excluded by a broader rule.
results/*.json
results/plots/*
!results/plots/.gitkeep
results/gradcam/*
!results/gradcam/.gitkeep
results/crop_check/*
!results/crop_check/.gitkeep
results/v2_gradcam/*
!results/v2_gradcam/.gitkeep

# OS / editor
.DS_Store
.ipynb_checkpoints/
